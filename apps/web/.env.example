# Base URL of the Estuara API.
# - Unset during `pnpm dev`: defaults to http://localhost:8000.
# - Unset during `pnpm build`: defaults to "" (same origin), which is what the
#   Cloudflare preview uses because the API is served from the same Worker.
# Set it only when the API is hosted on a different origin.
NEXT_PUBLIC_ESTUARA_API_URL=http://localhost:8000
